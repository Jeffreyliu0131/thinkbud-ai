{
  "name": "thinkbud",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cf": "npm run build && wrangler pages dev dist",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run release:check && wrangler pages deploy dist",
    "deploy:preview": "npm run verify && wrangler pages deploy dist --branch preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:gate": "node --import tsx evals/run.ts",
    "eval:rag": "node --import tsx evals/rag/run.ts",
    "eval:calibrate-grader": "node --import tsx evals/calibrate-grader.ts",
    "eval:live": "node --import tsx evals/generate-live-slice.ts",
    "provenance:check": "node scripts/generate-provenance.mjs",
    "evidence": "npm run eval:gate && npm run eval:rag && npm run provenance:check",
    "verify": "npm run lint && npm run typecheck && npm test && npm run evidence && npm run build",
    "release:check": "npm run verify && node scripts/check-release-readiness.mjs",
    "demo": "npm run evidence && vite --mode synthetic-demo",
    "demo:build": "npm run evidence && vite build --mode synthetic-demo",
    "rag:ingest": "node --import tsx scripts/ingest-textbook.ts"
  },
  "dependencies": {
    "@volcengine/rtc": "^4.68.2",
    "idb": "^8.0.3",
    "katex": "^0.16.44",
    "konva": "^10.2.3",
    "lucide-react": "^1.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.3",
    "react-router-dom": "^7.18.2",
    "use-image": "^1.1.4"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "express": "^5.2.1",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
