      "response": "先找作者反复写到的事物。哪一句最能代表它？",
      "expectedPass": true,
      "constraints": { "requiresOneQuestion": true }
    },
    {
      "id": "coach-safe-english",
      "type": "coach_response",
      "dimension": "multisubject",
      "grade": "lower",
      "phase": "original_guidance",
