      "response": "刚才你先凑成10。那8+5也能先凑10吗？",
      "expectedPass": true,
      "constraints": { "requiresOneQuestion": true, "requiresTransferBridge": true }
    },
    {
      "id": "coach-safe-transfer-upper",
      "type": "coach_response",
      "dimension": "transfer_question",
      "grade": "upper",
      "phase": "transfer",
      "input": "再给我一个同类型方程。",
      "response": "上一题先去掉常数项。试试2x+4=10，第一步对应什么？",
      "expectedPass": true,
      "constraints": { "requiresOneQuestion": true, "requiresTransferBridge": true }
    },
    {
      "id": "coach-safe-chinese",
      "type": "coach_response",
      "dimension": "multisubject",
      "grade": "upper",
