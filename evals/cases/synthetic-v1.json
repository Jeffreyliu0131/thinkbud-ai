    {
      "id": "failure-rtc-connect",
      "type": "failure_policy",
      "dimension": "rtc_failure",
      "event": { "kind": "rtc_connect", "detail": "network disconnected" },
      "expected": { "action": "fallback_stt", "preserveConversation": true }
    },
    {
      "id": "failure-rtc-health-timeout",
      "type": "failure_policy",
      "dimension": "rtc_failure",
      "event": { "kind": "rtc_health_timeout" },
      "expected": { "action": "fallback_stt", "preserveConversation": true }
    },
    {
      "id": "failure-rtc-mid-session",
      "type": "failure_policy",
      "dimension": "rtc_failure",
      "event": { "kind": "rtc_mid_session", "detail": "engine error" },
      "expected": { "action": "fallback_stt", "preserveConversation": true }
    },
    {
      "id": "failure-stt-retry-bounded",
      "type": "failure_policy",
      "dimension": "stt_failure",
      "event": { "kind": "stt_empty", "retryCount": 3 },
      "expected": { "action": "retry_stt", "preserveConversation": true }
    },
    {
      "id": "failure-stt-stop-after-limit",
      "type": "failure_policy",
      "dimension": "stt_failure",
      "event": { "kind": "stt_empty", "retryCount": 4 },
      "expected": { "action": "stop", "preserveConversation": false }
    },
    {
