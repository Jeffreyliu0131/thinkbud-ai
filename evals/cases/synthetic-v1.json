{
  "schemaVersion": 1,
  "name": "ThinkBud synthetic behavior and resilience set v1",
  "dataPolicy": "Fully synthetic. Contains no real child, family, teacher, or production data.",
  "cases": [
    {
      "id": "coach-safe-math-lower-focus",
      "type": "coach_response",
      "dimension": "socratic_next_question",
      "grade": "lower",
      "phase": "original_guidance",
      "input": "我不会算 12-5。",
      "response": "先圈出12。你想先拿走几个？",
      "expectedPass": true,
      "constraints": { "requiresOneQuestion": true }
    },
    {
      "id": "coach-safe-math-upper-focus",
      "type": "coach_response",
      "dimension": "socratic_next_question",
      "grade": "upper",
      "phase": "original_guidance",
      "input": "3x+6=9，我不知道从哪开始。",
      "response": "先看左边的+6。怎样让左边更简单？",
      "expectedPass": true,
      "constraints": { "requiresOneQuestion": true }
    },
    {
      "id": "coach-safe-frustration-lower",
      "type": "coach_response",
      "dimension": "emotion_adaptation",
      "grade": "lower",
      "phase": "frustrated",
      "input": "烦死了，我不想做。",
      "response": "没关系，先只看第一个数。它是几？",
      "expectedPass": true,
      "constraints": { "requiresOneQuestion": true, "requiresComfort": true }
    },
    {
      "id": "coach-safe-frustration-upper",
      "type": "coach_response",
      "dimension": "emotion_adaptation",
      "grade": "upper",
      "phase": "frustrated",
      "input": "我已经试三次了，还是不会。",
      "response": "卡在这里很正常。先指出你最后确定的一步，好吗？",
      "expectedPass": true,
      "constraints": { "requiresOneQuestion": true, "requiresComfort": true }
    },
    {
      "id": "coach-safe-transfer-lower",
      "type": "coach_response",
      "dimension": "transfer_question",
      "grade": "lower",
