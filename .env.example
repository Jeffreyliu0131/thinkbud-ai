# Copy to .env for local development. Never commit real values.

# Authentication
JWT_SECRET=
ADMIN_PASSWORD=
PHONE_HASH_SECRET=
AUTH_MODE=invite

# AI chat
ARK_API_KEY=
ARK_MODEL_ID=
ARK_VISION_MODEL_ID=
ARK_RTC_MODEL_ID=

# Textbook RAG (backend only; disabled unless a complete service is wired)
RAG_TEXTBOOK_ENABLED=false
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.12
RAG_CONTEXT_CHAR_BUDGET=6000
RAG_CONTEXT_TOKEN_BUDGET=1500
# Cloudflare adapter contract expects a TEXTBOOK_VECTORIZE binding. No binding,
# production embedding provider, index contents, or textbook is shipped here.

# Speech
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_CLUSTER=volcano_tts
TTS_VOICE_TYPE=zh_female_tianmeixiaoyuan_moon_bigtts
STT_APP_ID=
STT_ACCESS_TOKEN=
STT_CLUSTER=volcengine_streaming_common

# Real-time voice
RTC_APP_ID=
RTC_APP_KEY=
# Safety release flag: keep false until RTC live-output eval and human review pass.
VITE_ENABLE_RTC=false

# OCR
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# Optional SMS mode
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
