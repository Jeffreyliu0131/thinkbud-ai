# Copy to .env for local development. Never commit real values.

# Authentication
JWT_SECRET=
ADMIN_PASSWORD=
PHONE_HASH_SECRET=
AUTH_MODE=invite

# AI chat
ARK_API_KEY=
ARK_MODEL_ID=
ARK_VISION_MODEL_ID=
ARK_RTC_MODEL_ID=

# Speech
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_CLUSTER=volcano_tts
TTS_VOICE_TYPE=zh_female_tianmeixiaoyuan_moon_bigtts
STT_APP_ID=
STT_ACCESS_TOKEN=
STT_CLUSTER=volcengine_streaming_common

# Real-time voice
RTC_APP_ID=
RTC_APP_KEY=
# Safety release flag: keep false until RTC live-output eval and human review pass.
VITE_ENABLE_RTC=false

# OCR
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# Optional SMS mode
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
